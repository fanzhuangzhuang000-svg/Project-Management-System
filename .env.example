# ══════════════════════════════════════════════════════════════
#  弱电项目管理系统 · 专业版（网络版）配置
#  复制这个文件为 .env，改完双击 start.bat
# ══════════════════════════════════════════════════════════════

# ── 品牌 ──
# 第一次启动时自动写进系统设置，客户打开就是自己的名字
# （之后在「系统设置 → 界面自定义」里也能改）
COMPANY_NAME=示例机电工程有限公司

# ── 访问端口 ──
# 装完浏览器打开 http://localhost:8787
PORT=8787

# ── 管理员初始密码 ──
# 只在**首次启动、库还是空的时候**生效；之后改密码请到系统里改。
# 留空则用默认的 admin123（会强制要求登录后立刻修改）
ADMIN_PASSWORD=

# ── 数据库 ──
PG_DATABASE=elvpms
PG_USER=elvpms
# ⚠️ 上线前务必改掉。改了之后如果库里已经建过用户，需要同步改库里的密码或重建
# ⚠️ 必须填。留空的话 compose 会直接拒绝启动并告诉你缺哪一项 —— 这是故意的，
#    免得你复制完不编辑就用一个占位符密码跑起来。
PG_PASSWORD=

# ── 附件存储（MinIO）──
MINIO_ACCESS_KEY=elvpms
MINIO_SECRET_KEY=
MINIO_BUCKET=elv-pms
# MinIO 管理界面端口，出问题可以进去看附件在不在
MINIO_CONSOLE_PORT=9001

# ── 版本（升级用）──
# 发新版时改成新的版本号，重新 docker compose up -d 即可
# ⚠️ 必须和仓库 package.json 的 version 一致：这个文件会被 Docker 包原样交付，
#    客户复制成 .env 后 compose 就拿它当镜像标签。对不上由
#    tools/version-consistency-test.js 断言拦住。
VERSION=1.1.1
IMAGE_REPO=elv-pms

# ── 授权 ──
# 授权签名密钥。**改了它，之前发的授权码就全失效了**。
# 留空则用程序内置的默认密钥。
# ⚠️ 不要把自定义密钥填在这里交付给客户 —— 客户读到 .env 就等于拿到密钥。
#    只在你自己的签发机上设环境变量，签发端和部署端保持一致即可。
LICENSE_SECRET=

# ── 备份 ──
# 容器内路径，对应宿主机的 ./backup 目录
BACKUP_DIR=./backup

# ── 多租户隔离（⚠️ 实验性，默认别开）──
#
# 现状：只覆盖核心读写路径（listRows / getRow / insertRow / updateRow / deleteRow），
#       并配有 27 项越权测试。但下面这些**还没有**隔离：
#         · 首页统计与各聚合（看得到别人的金额、账龄）
#         · 附件上传/下载/列表（拿得到别人的扫描件）
#         · 操作日志、回收站、快照
#         · 各模块自己的 SQL（对账单、账龄、批量导入导出）
#
# 也就是说：**现在打开它，反而会让不同租户互相看到数据** —— 比不开更糟。
#
# 私有化部署请保持关闭（一个客户一套数据库，隔离本来就最彻底）。
# 等上面那些路径全部补齐并测试通过后，再改这里的说明。
#
# MULTI_TENANT=1
# ── AI 助手默认配置 ──
# 装完第一次启动时按这里写进系统（之后在界面里也能改）。
# 不填也能用，客户自己进「AI 助手」页配置即可。
#
# 是否默认开启。留空 = 不预设（由客户在界面决定）
# AI_ENABLED=false
#
# 模型厂商：deepseek / qwen / kimi / zhipu / doubao / openai / claude / ollama / custom
# AI_PROVIDER=deepseek
#
# 密钥。填了就自动配好，客户直接能用
# AI_API_KEY=
#
# 模型名，留空用厂商默认
# AI_MODEL=
# ── MinIO 镜像（注意）──
# MinIO 官方已经不在 Docker Hub 公开发布了（minio/minio 现在拉不到）。
# 默认用 chainguard 的构建；你有自己的镜像仓库就换成你的。
# 只要实现 S3 协议，任何兼容服务都能用（本系统走标准 S3 API）。
MINIO_IMAGE=chainguard/minio:latest